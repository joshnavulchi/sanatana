      "factors": [
        {
          "title": "International Law & UN",
          "explanation": "UN Charter and norms protect territorial integrity."
        },
        {
          "title": "End of Colonial Empires",
          "explanation": "Most decolonization ended by the 1970s; borders were frozen (uti possidetis juris)."
        },
        {
          "title": "Collapse of Big Federations Completed",
          "explanation": "USSR & Yugoslavia dissolved; no similar entities remained to fragment."
        },
        {
          "title": "Globalization",
          "explanation": "Interdependence reduces benefits of conquest."
        },
        {
          "title": "Deterrence & Sanctions",
          "explanation": "Costs of changing borders are high."
        },
        {
          "title": "Dispute Management",
          "explanation": "Conflicts handled via autonomy/frozen conflicts rather than redrawing."
        }
      ],
      "keytakeaway": "Modern borders are legally and politically rigid even where disputes exist.",
      "summary": "After the late 20th century, borders stabilized due to legal, political, economic, and deterrence factors."
