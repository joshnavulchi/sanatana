{
  "book1": {
    "id": "AV-BOOK-1",
    "hymns": [
      {
        "id": "AV-1-1",
        "hymn_number": 1,
        "title": "Charm Against Fever",
        "verses": [
          {
            "id": "AV-1-1-1",
            "verse_number": 1,
            "sanskrit": "यदग्ने तपसा तपस्विनं ज्वरं दहसि",
            "transliteration": "yad agne tapasā tapasvinaṃ jvaraṃ dahasi",
            "meaning": {
              "literal": "O Agni, by your heat you burn the burning fever.",
              "interpretive": "Agni symbolizes purifying metabolic fire removing disease.",
              "applied": "Represents immune activation and heat-based healing."
            },
            "entities": {
              "deities": [
                "Agni"
              ],
              "concepts": [
                "Fever",
                "Heat",
                "Purification"
              ]
            },
            "cross_references": {
              "rigveda": [
                {
                  "reference": "RV 1.1",
                  "concept": "Agni as purifier"
                }
              ]
            }
          },
          {
            "id": "AV-1-1-2",
            "verse_number": 2,
            "sanskrit": "ज्वरं ते नाशयाम्यग्ने",
            "transliteration": "jvaraṃ te nāśayāmy agne",
            "meaning": {
              "literal": "O Agni, I destroy your fever.",
              "interpretive": "Disease is external and removable.",
              "applied": "Concept of disease elimination."
            }
          },
          {
            "id": "AV-1-1-3",
            "verse_number": 3,
            "sanskrit": "अशीतोष्णं ज्वरं हरामि",
            "transliteration": "aśītoṣṇaṃ jvaraṃ harāmi",
            "meaning": {
              "literal": "I remove both cold and hot fever.",
              "interpretive": "Recognition of different fever types.",
              "applied": "Proto-classification of diseases."
            }
          }
        ]
      },
      {
        "id": "AV-1-2",
        "hymn_number": 2,
        "title": "Herbal Medicine Invocation",
        "verses": [
          {
            "id": "AV-1-2-1",
            "verse_number": 1,
            "sanskrit": "ओषधयः भेषजं भवन्तु",
            "transliteration": "oṣadhayaḥ bheṣajaṃ bhavantu",
            "meaning": {
              "literal": "Let the herbs become medicine.",
              "interpretive": "Plants are sacred healers.",
              "applied": "Foundation of herbal pharmacology."
            },
            "entities": {
              "elements": [
                "Plants"
              ],
              "concepts": [
                "Medicine"
              ]
            },
            "cross_references": {
              "rigveda": [
                {
                  "reference": "RV 10.97",
                  "concept": "Medicinal plants hymn"
                }
              ]
            }
          },
          {
            "id": "AV-1-2-2",
            "verse_number": 2,
            "sanskrit": "याः पृथिव्यां ओषधयः",
            "transliteration": "yāḥ pṛthivyāṃ oṣadhayaḥ",
            "meaning": {
              "literal": "Those herbs that grow upon the earth.",
              "interpretive": "Earth as source of healing.",
              "applied": "Natural medicine origin."
            }
          }
        ]
      },
      {
        "id": "AV-1-3",
        "hymn_number": 3,
        "title": "Protection from Evil Forces",
        "verses": [
          {
            "id": "AV-1-3-1",
            "verse_number": 1,
            "sanskrit": "रक्षांसि नुदामि मन्त्रेण",
            "transliteration": "rakṣāṃsi nudāmi mantreṇa",
            "meaning": {
              "literal": "I drive away demons by mantra.",
              "interpretive": "Sound vibration protects consciousness.",
              "applied": "Psychological and spiritual shielding."
            }
          },
          {
            "id": "AV-1-3-2",
            "verse_number": 2,
            "sanskrit": "अभयं मे अस्तु",
            "transliteration": "abhayaṃ me astu",
            "meaning": {
              "literal": "Let there be fearlessness for me.",
              "interpretive": "Protection leads to inner stability.",
              "applied": "Mental resilience."
            }
          }
        ]
      },
      {
        "id": "AV-1-4",
        "hymn_number": 4,
        "title": "Longevity and Vital Energy",
        "classification": {
          "category": "Healing",
          "sub_category": "Longevity"
        },
        "verses": [
          {
            "id": "AV-1-4-1",
            "verse_number": 1,
            "sanskrit": "दीर्घायुत्वं मे देहि",
            "transliteration": "dīrghāyutvaṃ me dehi",
            "meaning": {
              "literal": "Grant me long life.",
              "interpretive": "Longevity is seen as divine blessing.",
              "applied": "Focus on preventive and sustained health."
            },
            "entities": {
              "concepts": [
                "Longevity",
                "Vitality"
              ]
            }
          },
          {
            "id": "AV-1-4-2",
            "verse_number": 2,
            "sanskrit": "प्राणान् मे पाही",
            "transliteration": "prāṇān me pāhi",
            "meaning": {
              "literal": "Protect my life forces (prana).",
              "interpretive": "Prana as sustaining energy of life.",
              "applied": "Breath and vitality awareness."
            }
          },
          {
            "id": "AV-1-4-3",
            "verse_number": 3,
            "sanskrit": "बलं मे देहि तनुवे",
            "transliteration": "balaṃ me dehi tanuve",
            "meaning": {
              "literal": "Give strength to my body.",
              "interpretive": "Strength is essential to life continuity.",
              "applied": "Physical resilience and immunity."
            }
          }
        ]
      },
      {
        "id": "AV-1-5",
        "hymn_number": 5,
        "title": "Expulsion of Poison",
        "classification": {
          "category": "Healing",
          "sub_category": "Detoxification"
        },
        "verses": [
          {
            "id": "AV-1-5-1",
            "verse_number": 1,
            "sanskrit": "विषं निरस्यामि शरीरात्",
            "transliteration": "viṣaṃ nirasyāmi śarīrāt",
            "meaning": {
              "literal": "I expel poison from the body.",
              "interpretive": "Poison disrupts natural harmony.",
              "applied": "Detoxification concept."
            },
            "entities": {
              "concepts": [
                "Poison",
                "Detox"
              ]
            }
          },
          {
            "id": "AV-1-5-2",
            "verse_number": 2,
            "sanskrit": "अग्निना विषं दहामि",
            "transliteration": "agninā viṣaṃ dahāmi",
            "meaning": {
              "literal": "With fire I burn the poison.",
              "interpretive": "Agni transforms harmful substances.",
              "applied": "Metabolic detox processes."
            },
            "cross_references": {
              "rigveda": [
                {
                  "reference": "RV 1.1",
                  "concept": "Agni purification"
                }
              ]
            }
          },
          {
            "id": "AV-1-5-3",
            "verse_number": 3,
            "sanskrit": "अपसर्प विष",
            "transliteration": "apasarpa viṣa",
            "meaning": {
              "literal": "Depart, O poison.",
              "interpretive": "Commanding removal of toxins.",
              "applied": "Psychosomatic healing command."
            }
          }
        ]
      },
      {
        "id": "AV-1-6",
        "hymn_number": 6,
        "title": "Victory and Protection in Conflict",
        "classification": {
          "category": "Protection",
          "sub_category": "Conflict / Victory"
        },
        "verses": [
          {
            "id": "AV-1-6-1",
            "verse_number": 1,
            "sanskrit": "इन्द्रः शत्रून् जयतु",
            "transliteration": "indraḥ śatrūn jayatu",
            "meaning": {
              "literal": "May Indra conquer the enemies.",
              "interpretive": "Indra symbolizes power and dominance.",
              "applied": "Inner courage and confidence."
            },
            "entities": {
              "deities": [
                "Indra"
              ]
            },
            "cross_references": {
              "rigveda": [
                {
                  "reference": "RV 1.32",
                  "concept": "Indra slays Vritra"
                }
              ]
            }
          },
          {
            "id": "AV-1-6-2",
            "verse_number": 2,
            "sanskrit": "अभिभव शत्रून्",
            "transliteration": "abhibhava śatrūn",
            "meaning": {
              "literal": "Overcome the enemies.",
              "interpretive": "Victory over external and internal obstacles.",
              "applied": "Overcoming fear and doubt."
            }
          },
          {
            "id": "AV-1-6-3",
            "verse_number": 3,
            "sanskrit": "जयामि सर्वान्",
            "transliteration": "jayāmi sarvān",
            "meaning": {
              "literal": "I conquer all.",
              "interpretive": "Affirmation of success.",
              "applied": "Self-belief reinforcement."
            }
          }
        ]
      },
      {
        "id": "AV-1-7",
        "hymn_number": 7,
        "title": "Peace, Harmony and Fearlessness",
        "classification": {
          "category": "Well-being",
          "sub_category": "Mental Peace"
        },
        "verses": [
          {
            "id": "AV-1-7-1",
            "verse_number": 1,
            "sanskrit": "शं नो भवतु",
            "transliteration": "śaṃ no bhavatu",
            "meaning": {
              "literal": "May there be peace for us.",
              "interpretive": "Peace is fundamental to well-being.",
              "applied": "Mental calm and emotional stability."
            }
          },
          {
            "id": "AV-1-7-2",
            "verse_number": 2,
            "sanskrit": "अभयं मे अस्तु",
            "transliteration": "abhayaṃ me astu",
            "meaning": {
              "literal": "Let me be free from fear.",
              "interpretive": "Fearlessness is spiritual strength.",
              "applied": "Confidence and anxiety reduction."
            }
          },
          {
            "id": "AV-1-7-3",
            "verse_number": 3,
            "sanskrit": "शान्तिः शान्तिः शान्तिः",
            "transliteration": "śāntiḥ śāntiḥ śāntiḥ",
            "meaning": {
              "literal": "Peace, peace, peace.",
              "interpretive": "Peace at physical, mental, and spiritual levels.",
              "applied": "Holistic harmony."
            }
          }
        ]
      },
      {
        "id": "AV-1-8",
        "hymn_number": 8,
        "title": "Removal of Disease and Weakness",
        "classification": {
          "category": "Healing",
          "sub_category": "General Disease Removal"
        },
        "verses": [
          {
            "id": "AV-1-8-1",
            "verse_number": 1,
            "sanskrit": "यद् रोगं तन्वोऽपगच्छतु",
            "transliteration": "yad rogaṃ tanvo'pagacchatu",
            "meaning": {
              "literal": "Let the disease depart from the body.",
              "interpretive": "Disease is treated as separable from self.",
              "applied": "Concept of healing through removal of imbalance."
            }
          },
          {
            "id": "AV-1-8-2",
            "verse_number": 2,
            "sanskrit": "बलं मे पुनरागच्छतु",
            "transliteration": "balaṃ me punar āgacchatu",
            "meaning": {
              "literal": "Let strength return to me.",
              "interpretive": "Healing restores vitality.",
              "applied": "Recovery and regeneration."
            }
          }
        ]
      },
      {
        "id": "AV-1-9",
        "hymn_number": 9,
        "title": "Charm for Protection of the Body",
        "classification": {
          "category": "Protection",
          "sub_category": "Physical Safety"
        },
        "verses": [
          {
            "id": "AV-1-9-1",
            "verse_number": 1,
            "sanskrit": "तनुं मे पातु देवाः",
            "transliteration": "tanuṃ me pātu devāḥ",
            "meaning": {
              "literal": "May the gods protect my body.",
              "interpretive": "Divine forces guard physical existence.",
              "applied": "Holistic protection belief."
            },
            "entities": {
              "concepts": [
                "Protection",
                "Body"
              ]
            }
          },
          {
            "id": "AV-1-9-2",
            "verse_number": 2,
            "sanskrit": "सर्वतः मां पान्तु",
            "transliteration": "sarvataḥ māṃ pāntu",
            "meaning": {
              "literal": "May they protect me from all sides.",
              "interpretive": "Total security from all directions.",
              "applied": "Complete environmental safety."
            }
          }
        ]
      },
      {
        "id": "AV-1-10",
        "hymn_number": 10,
        "title": "Release from Sin and Negativity",
        "classification": {
          "category": "Spiritual Healing",
          "sub_category": "Purification"
        },
        "verses": [
          {
            "id": "AV-1-10-1",
            "verse_number": 1,
            "sanskrit": "पापं मे अपगच्छतु",
            "transliteration": "pāpaṃ me apagacchatu",
            "meaning": {
              "literal": "Let sin depart from me.",
              "interpretive": "Negativity is removable.",
              "applied": "Moral and psychological cleansing."
            }
          },
          {
            "id": "AV-1-10-2",
            "verse_number": 2,
            "sanskrit": "शुद्धोऽहम् भवामि",
            "transliteration": "śuddho'ham bhavāmi",
            "meaning": {
              "literal": "I become purified.",
              "interpretive": "Purity is achievable state.",
              "applied": "Self-renewal."
            }
          }
        ]
      },
      {
        "id": "AV-1-11",
        "hymn_number": 11,
        "title": "Harmony with Natural Forces",
        "classification": {
          "category": "Cosmic Harmony",
          "sub_category": "Nature Alignment"
        },
        "verses": [
          {
            "id": "AV-1-11-1",
            "verse_number": 1,
            "sanskrit": "पृथिवी मे शं करोतु",
            "transliteration": "pṛthivī me śaṃ karotu",
            "meaning": {
              "literal": "May the Earth bring me peace.",
              "interpretive": "Earth is nurturing and stabilizing.",
              "applied": "Grounding and connection to nature."
            },
            "entities": {
              "elements": [
                "Earth"
              ]
            }
          },
          {
            "id": "AV-1-11-2",
            "verse_number": 2,
            "sanskrit": "आपः मे शं करोतु",
            "transliteration": "āpaḥ me śaṃ karotu",
            "meaning": {
              "literal": "May the waters bring me peace.",
              "interpretive": "Water purifies and sustains life.",
              "applied": "Hydration and cleansing symbolism."
            }
          }
        ]
      },
      {
        "id": "AV-1-12",
        "hymn_number": 12,
        "title": "Strength and Stability",
        "classification": {
          "category": "Well-being",
          "sub_category": "Strength"
        },
        "verses": [
          {
            "id": "AV-1-12-1",
            "verse_number": 1,
            "sanskrit": "स्थिरो भवामि",
            "transliteration": "sthiro bhavāmi",
            "meaning": {
              "literal": "I become stable.",
              "interpretive": "Stability is inner strength.",
              "applied": "Mental steadiness."
            }
          },
          {
            "id": "AV-1-12-2",
            "verse_number": 2,
            "sanskrit": "बलं मे अस्तु",
            "transliteration": "balaṃ me astu",
