              "applied": "Physical and mental empowerment."
            }
          }
        ]
      },
      {
        "id": "AV-1-13",
        "hymn_number": 13,
        "title": "Charm Against Disease (Takman/Fever Variant)",
        "sources": {
          "whitney": "AV I.13",
          "bloomfield": "AV Book 1 Hymn 13"
        },
        "classification": {
          "category": "Healing",
          "sub_category": "Fever / Takman"
        },
        "verses": [
          {
            "id": "AV-1-13-1",
            "verse_number": 1,
            "sanskrit": "तकमन् त्वा परि दद्मि दूरं गच्छ",
            "transliteration": "takman tvā pari dadmi dūraṃ gaccha",
            "meaning": {
              "literal": "O fever (Takman), I send you away—go far.",
              "interpretive": "Disease is externalized and expelled.",
              "applied": "Early therapeutic exorcism model."
            },
            "entities": {
              "concepts": [
                "Takman (fever)",
                "Disease expulsion"
              ]
            }
          },
          {
            "id": "AV-1-13-2",
            "verse_number": 2,
            "sanskrit": "यत्र न स्याः पुनरागाः",
            "transliteration": "yatra na syāḥ punar āgāḥ",
            "meaning": {
              "literal": "Go where you do not return.",
              "interpretive": "Desire for permanent cure.",
              "applied": "Prevention of relapse."
            }
          }
        ]
      },
      {
        "id": "AV-1-14",
        "hymn_number": 14,
        "title": "Charm for Healing Wounds",
        "sources": {
          "whitney": "AV I.14"
        },
        "classification": {
          "category": "Healing",
          "sub_category": "Wound Recovery"
        },
        "verses": [
          {
            "id": "AV-1-14-1",
            "verse_number": 1,
            "sanskrit": "यथा वृक्षस्य छिन्नं पुनः संवर्धते",
            "transliteration": "yathā vṛkṣasya chinnaṃ punaḥ saṃvardhate",
            "meaning": {
              "literal": "As a cut tree grows again.",
              "interpretive": "Nature models healing.",
              "applied": "Tissue regeneration analogy."
            }
          },
          {
            "id": "AV-1-14-2",
            "verse_number": 2,
            "sanskrit": "एवं मे अङ्गं पुनः रोहतु",
            "transliteration": "evaṃ me aṅgaṃ punaḥ rohatu",
            "meaning": {
              "literal": "So may my limb grow again.",
              "interpretive": "Body restores itself.",
              "applied": "Recovery and regeneration principle."
            }
          }
        ]
      },
      {
        "id": "AV-1-15",
        "hymn_number": 15,
        "title": "Protection from Sorcery",
        "sources": {
          "whitney": "AV I.15",
          "bloomfield": "Charm against witchcraft"
        },
        "classification": {
          "category": "Protection",
          "sub_category": "Anti-Sorcery"
        },
        "verses": [
          {
            "id": "AV-1-15-1",
            "verse_number": 1,
            "sanskrit": "यद् अभिचारं कृतं तद् निवर्तयामि",
            "transliteration": "yad abhichāraṃ kṛtaṃ tad nivartayāmi",
            "meaning": {
              "literal": "Whatever sorcery has been done, I turn it back.",
              "interpretive": "Neutralization of hostile intent.",
              "applied": "Psychological protection from fear."
            }
          },
          {
            "id": "AV-1-15-2",
            "verse_number": 2,
            "sanskrit": "मन्त्रेण तद् भिन्दामि",
            "transliteration": "mantreṇa tad bhindāmi",
            "meaning": {
              "literal": "By mantra I break it.",
              "interpretive": "Sound as protective force.",
              "applied": "Affirmation as mental defense."
            }
          }
        ]
      },
      {
        "id": "AV-1-16",
        "hymn_number": 16,
        "title": "Charm for Harmony in Household",
        "sources": {
          "whitney": "AV I.16"
