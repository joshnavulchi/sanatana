          }
        ]
      },
      {
        "id": "AV-1-18",
        "hymn_number": 18,
        "title": "Charm for Removal of Fear",
        "sources": {
          "whitney": "AV I.18"
        },
        "classification": {
          "category": "Protection",
          "sub_category": "Fear Removal"
        },
        "verses": [
