        "id": "AV-5-1",
        "hymn_number": 1,
        "title": "Charm for Healing from Severe Disease",
        "verses": [
          {
            "id": "AV-5-1-1",
            "verse_number": 1,
            "sanskrit": "शं नो अस्तु",
            "transliteration": "śaṃ no astu",
            "meaning": {
              "literal": "May there be peace for us.",
              "interpretive": "Invocation of harmony.",
              "applied": "Well-being."
            }
          },
          {
            "id": "AV-5-1-2",
            "verse_number": 2,
            "sanskrit": "बलं मे देहि",
            "transliteration": "balaṃ me dehi",
            "meaning": {
              "literal": "Grant me strength.",
              "interpretive": "Strength sustains action.",
              "applied": "Energy and resilience."
            }
          }
        ]
      },
