    "hymns": [
      {
        "id": "AV-2-1",
        "hymn_number": 1,
        "title": "Charm for Healing and Restoration",
        "sources": {
          "whitney": "AV II.1"
        },
        "classification": {
          "category": "Healing",
          "sub_category": "Restoration"
        },
        "verses": [
          {
            "id": "AV-2-1-1",
            "verse_number": 1,
            "sanskrit": "यत् ते रोगं तद् अपहामि",
            "transliteration": "yat te rogaṃ tad apahāmi",
            "meaning": {
              "literal": "That disease of yours I remove.",
              "interpretive": "Illness is separable and removable.",
              "applied": "Therapeutic intervention concept."
            }
          },
          {
            "id": "AV-2-1-2",
            "verse_number": 2,
            "sanskrit": "पुनः त्वा स्वस्थं करोमि",
            "transliteration": "punaḥ tvā svasthaṃ karomi",
            "meaning": {
              "literal": "I make you healthy again.",
              "interpretive": "Healing restores original balance.",
              "applied": "Recovery process."
            }
          }
        ]
      },
      {
        "id": "AV-2-2",
        "hymn_number": 2,
        "title": "Charm Against Disease-Spirits",
        "sources": {
          "whitney": "AV II.2"
        },
        "classification": {
          "category": "Protection",
          "sub_category": "Disease Spirits"
        },
        "verses": [
          {
            "id": "AV-2-2-1",
            "verse_number": 1,
            "sanskrit": "ये रोगाः भूताः तान् नुदामि",
            "transliteration": "ye rogāḥ bhūtāḥ tān nudāmi",
            "meaning": {
              "literal": "Those disease-spirits I drive away.",
              "interpretive": "Disease conceptualized as external entity.",
              "applied": "Early pathogen metaphor."
            }
          },
          {
            "id": "AV-2-2-2",
            "verse_number": 2,
            "sanskrit": "दूरं गच्छन्तु ते",
            "transliteration": "dūraṃ gacchantu te",
            "meaning": {
              "literal": "Let them go far away.",
              "interpretive": "Removal ensures protection.",
              "applied": "Preventive health."
            }
          }
        ]
      },
      {
        "id": "AV-2-3",
        "hymn_number": 3,
        "title": "Charm for Strengthening Life Force",
        "sources": {
          "whitney": "AV II.3"
        },
        "classification": {
          "category": "Healing",
          "sub_category": "Vital Energy"
        },
        "verses": [
          {
            "id": "AV-2-3-1",
            "verse_number": 1,
            "sanskrit": "प्राणान् मे धेहि",
            "transliteration": "prāṇān me dhehi",
            "meaning": {
              "literal": "Establish life forces in me.",
              "interpretive": "Prana sustains existence.",
              "applied": "Breath-energy awareness."
            }
          },
          {
            "id": "AV-2-3-2",
            "verse_number": 2,
            "sanskrit": "ओजः बलं च मे अस्तु",
            "transliteration": "ojaḥ balaṃ ca me astu",
            "meaning": {
              "literal": "May vitality and strength be mine.",
              "interpretive": "Ojas as core life essence.",
              "applied": "Immunity and stamina."
            }
          }
        ]
      },
      {
