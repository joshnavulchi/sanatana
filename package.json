{
  "name": "sanatanadharmam.in",
  "version": "0.1.3",
  "packageManager": "yarn@4.12.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "predev": "node scripts/download-locales.js --skip-if-meta && node scripts/compile-scss.js --dev",
    "dev": "yarn run next dev",
    "prebuild": "yarn run lint && node scripts/download-locales.js --skip-if-meta && node scripts/compile-scss.js --force && yarn run generate:critical:home",
    "build": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "postbuild": "node scripts/compile-scss.js --verify && node scripts/strip-comments.js && node scripts/generate-sitemap.js && yarn run minify:html && node scripts/add-hash-to-assets.js && node scripts/check-analytics-keys.js",
    "strip:comments": "node scripts/strip-comments.js",
    "build:server": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "scss:build": "node scripts/compile-scss.js --force",
    "scss:build:dev": "node scripts/compile-scss.js --dev --force",
    "scss:watch": "yarn run sass --watch app/styles.scss:public/globals.from-scss.css",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:critical:home": "node scripts/generate-critical-css.js",
    "render-build": "yarn run build",
    "incremental:export": "node scripts/incremental-export.js",
    "export:partial": "node scripts/partial-export.js",
    "start": "yarn run next start",
    "preview:static": "yarn run serve@latest out -l 3000",
    "lint": "yarn run eslint --quiet app lib scripts",
    "minify:html": "node scripts/minify-html.js",
    "noEmit": "yarn run tsc --noEmit",
    "check-updates": "yarn run npm-check-updates",
    "update-libs": "yarn run npm-check-updates -u && yarn install",
    "clean": "Remove-Item node_modules, package-lock.json, yarn.lock, .next, out, .cache, .parcel-cache -Recurse -Force -ErrorAction SilentlyContinue"
  },
  "dependencies": {
    "mongodb": "^7.1.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "autoprefixer": "^10.4.24",
    "d3": "^7.9.0",
    "eslint": "^9.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "glob": "^10.5.0",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.5.6",
    "sass": "^1.97.3",
    "sharp": "^0.34.5",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3"
  }
}
