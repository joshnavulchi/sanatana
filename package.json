{
  "name": "sanatanadharmam.in",
  "version": "0.1.3",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "predev": "node scripts/download-locales.js",
    "dev": "next dev",
    "prebuild": "node scripts/download-locales.js && npm run scss:build && npm run generate:critical:home",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "postbuild": "node scripts/strip-comments.js && node scripts/generate-sitemap.js",
    "strip:comments": "node scripts/strip-comments.js",
    "build:server": "cross-env NEXT_TELEMETRY_DISABLED=1 node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "scss:build": "sass app/styles.scss public/globals.from-scss.css --style=compressed --no-source-map",
    "scss:build:dev": "sass app/styles.scss public/globals.from-scss.css --embed-source-map",
    "scss:watch": "sass --watch app/styles.scss:public/globals.from-scss.css",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:critical:home": "node scripts/generate-critical-css.js",
    "render-build": "npm ci --include=dev && cross-env NEXT_STATIC_EXPORT=true npm run build",
    "start": "next start",
    "preview:static": "npx serve@latest out -l 3000",
    "lint": "eslint",
    "test": "jest --runInBand",
    "noEmit": "npx tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "beasties": "^0.4.1",
    "mongodb": "^7",
    "next": "^16.1.4",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.1.18"
  },
  "optionalDependencies": {
    "luxon": "^3.7.2",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "baseline-browser-mapping": "^2.9.17",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "d3": "^7.9.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "googleapis": "^170.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "sass": "^1.97.3",
    "sharp": "^0.34.5",
    "topojson-client": "^3.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "5.9.3",
    "webpack": "^5.0.0"
  },
  "overrides": {
    "nanoid": "3.3.8"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "not dead",
    "not IE 11"
  ]
}
