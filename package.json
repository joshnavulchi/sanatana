{
  "name": "sanatanadharmam.in",
  "version": "0.1.3",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "predev": "node scripts/download-locales.js --skip-if-meta",
    "dev": "next dev",
    "prebuild": "node scripts/download-locales.js --skip-if-meta && npm run scss:build && npm run generate:critical:home",
    "build": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "postbuild": "node scripts/strip-comments.js && node scripts/generate-sitemap.js",
    "strip:comments": "node scripts/strip-comments.js",
    "build:server": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "scss:build": "sass app/styles.scss public/globals.from-scss.css --style=compressed --no-source-map",
    "scss:build:dev": "sass app/styles.scss public/globals.from-scss.css --embed-source-map",
    "scss:watch": "sass --watch app/styles.scss:public/globals.from-scss.css",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:critical:home": "node scripts/generate-critical-css.js",
    "render-build": "npm ci --include=dev && npm run build",
    "start": "next start",
    "preview:static": "npx serve@latest out -l 3000",
    "lint": "eslint",
    "noEmit": "npx tsc --noEmit"
  },
  "dependencies": {
    "mongodb": "^7",
    "next": "^16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.1.18",
    "web-vitals": "^5.1.0"
  },
  "optionalDependencies": {
    "luxon": "^3.7.2",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.4",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "d3": "^7.9.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "googleapis": "^170.1.0",
    "sass": "^1.97.3",
    "sharp": "^0.34.5",
    "topojson-client": "^3.1.0",
    "typescript": "5.9.3",
    "webpack": "^5.0.0"
  },
  "overrides": {
    "nanoid": "3.3.8"
  }
}
