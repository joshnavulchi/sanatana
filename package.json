{
  "name": "sanatanadharmam.in",
  "version": "0.1.3",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "predev": "node scripts/download-locales.js --skip-if-meta && node scripts/compile-scss.js --dev",
    "dev": "next dev",
    "prebuild": "npm run lint && node scripts/download-locales.js --skip-if-meta && node scripts/compile-scss.js --force && npm run generate:critical:home",
    "build": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "postbuild": "node scripts/compile-scss.js --verify && node scripts/strip-comments.js && node scripts/generate-sitemap.js && npm run minify:html && node scripts/add-hash-to-assets.js && node scripts/check-analytics-keys.js",
    "strip:comments": "node scripts/strip-comments.js",
    "build:server": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "scss:build": "node scripts/compile-scss.js --force",
    "scss:build:dev": "node scripts/compile-scss.js --dev --force",
    "scss:watch": "sass --watch app/styles.scss:public/globals.from-scss.css",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:critical:home": "node scripts/generate-critical-css.js",
    "render-build": "npm ci --include=dev && npm run build",
    "start": "next start",
    "preview:static": "npx serve@latest out -l 3000",
    "lint": "eslint --quiet",
    "minify:html": "node scripts/minify-html.js",
    "noEmit": "npx tsc --noEmit",
    "check-updates": "npx npm-check-updates",
    "update-libs": "npx npm-check-updates -u && npm install",
    "clean": "Remove-Item node_modules, package-lock.json, .next, .cache, .parcel-cache -Recurse -Force -ErrorAction SilentlyContinue"
  },
  "dependencies": {
    "mongodb": "^7",
    "next": "^16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.1.18",
    "web-vitals": "^5.1.0"
  },
  "optionalDependencies": {
    "luxon": "^3.7.2",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.24",
    "critters": "^0.0.25",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "d3": "^7.9.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "googleapis": "^171.2.0",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.5.6",
    "react-placeholder-image": "^0.1.8",
    "readline-sync": "^1.4.10",
    "recast": "^0.23.11",
    "sass": "^1.97.3",
    "sharp": "^0.34.5",
    "topojson-client": "^3.1.0",
    "typescript": "5.9.3",
    "webpack": "^5.105.0"
  },
  "overrides": {
    "nanoid": "3.3.8"
  }
}
