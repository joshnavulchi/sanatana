    "sections": [
      {
        "id": "概述",
        "title": "概述",
        "paragraphs": [
          "滴灌利用沿侧向分布的发射器以受控的低流量直接将水输送到根部区域。目标是使土壤吸收能力和作物需求相匹配，同时最大限度地减少蒸发、径流和深层渗滤。",
          "一个完整的系统通常包括：水源和抽水、过滤、压力调节、主干管和次干管输送、带滴水器的支管、阀门和自动化系统、灌溉施肥和冲洗点。"
        ],
        "bullets": [
          "发射器的典型工作压力：0.7–1.5 bar (10–22 psi)。",
          "普通发射器排放量：1、2、4、8 LPH（升/小时）。",
          "均匀性取决于压力稳定性、过滤效率和水力设计。"
        ]
      },
      {
        "id": "原则",
        "title": "它是如何运作的",
        "steps": [
          {
            "icon": null,
            "title": "受控应用",
            "details": "发射器将入口压力转化为小而稳定的流量（水滴或细流）。水渗入滴头周围，形成湿球，当间距正确时，该湿球与相邻球重叠。"
          },
          {
            "icon": null,
            "title": "先过滤",
            "details": "筛网、砂/介质或盘式过滤器可去除悬浮固体和生物负载，否则会堵塞发射器。过滤尺寸根据水质和发射器孔口而定。"
          },
          {
            "icon": null,
            "title": "压力稳定",
            "details": "压力调节器和平衡的管道尺寸使整个块的压力变化保持在较低水平，因此每个发射器的排放量接近其额定排放量。"
          },
          {
            "icon": null,
            "title": "定期冲洗",
            "details": "总管和支管的末端包括冲洗阀或可拆卸端盖，以在启动时和灌溉施肥后清除沉积物和生物膜。"
          }
        ]
      },
      {
        "id": "成分",
        "title": "系统组成",
        "items": [
          {
            "name": "水源及水泵",
            "function": "提供足够的流量和扬程。从开放源获取时，请包括底阀/过滤器。",
            "sizingNotes": "泵头必须涵盖过滤器损失、调节器损失、管道/摩擦损失、标高和最小发射器压力。"
          },
          {
            "name": "过滤装置",
            "function": "保护发射器免受堵塞。",
            "sizingNotes": "对于高有机负荷，使用砂/介质过滤器，对于细颗粒使用筛网或圆盘；尺寸适合具有反冲洗能力的系统流量。"
          },
          {
            "name": "肥料注射（文丘里管或计量泵）",
            "function": "将可溶性肥料注入灌溉水中。",
            "sizingNotes": "提供止回阀和旁路；放置在过滤器之后以避免介质污染。"
          },
          {
            "name": "主、副主管道",
            "function": "以最小的水头损失将水输送到田块。",
            "sizingNotes": "保持速度0.6-1.5 m/s；在高点增设排气阀；在末端提供冲洗点。"
          },
          {
            "name": "侧肌",
            "function": "沿作物行将水输送到排放器。",
            "sizingNotes": "根据直径、滴头间距和允许压力变化（通常≤20%）限制横向长度。"
          },
          {
            "name": "滴头/滴水器",
            "function": "测量流向根区的流量。",
            "sizingNotes": "选择每种作物/土壤的排放量 (LPH)；压力补偿类型有助于斜坡或不同长度的情况。"
          },
          {
            "name": "阀门和自动化",
            "function": "开/关控制、区域选择、自动调度。",
            "sizingNotes": "将手动/电磁阀与定时器/控制器相结合；在过滤器上添加压力表。"
          }
        ]
      },
      {
        "id": "设计",
        "title": "设计工作流程",
        "steps": [
          {
            "step": "现场勘察",
            "details": [
              "绘制场地尺寸、坡度和高程差。",
              "找到水源、电力和维护通道。",
              "确定土壤质地（沙子/壤土/粘土）和渗透率。"
            ]
          },
          {
            "step": "作物间距和布局",
            "details": [
              "记录行距和株距；估计树冠蔓延。",
              "决定每行的侧向（蔬菜：1-2；果园：发射器或环形布局）。"
            ]
          },
          {
            "step": "发射器选择",
            "details": [
              "镐排出量：1–8 LPH 是常见的。",
              "根据根区和土壤分布设置发射器间距。",
              "目标施用量等于或低于土壤摄入量。"
            ]
          },
          {
            "step": "块大小",
            "details": [
              "将农场划分为液压块，使总流量适合泵容量和过滤器额定值。",
              "保持块内的横向长度均匀。"
            ]
          },
          {
            "step": "管道尺寸",
            "details": [
              "选择主/副主直径以保持合理的摩擦损失。",
              "确保流速为 0.6–1.5 m/s，以避免沉积物沉降或水锤。"
            ]
          },
          {
            "step": "压力调节与控制",
            "details": [
              "将调节器放置在过滤器之后。",
              "每个块添加隔离阀和压力表以进行监控。"
            ]
          }
        ]
      },
      {
        "id": "水力学",
        "title": "水力计算",
        "notes": "保持最下游滴头压力≥最小额定值。将所有水头损失和海拔变化相加。",
        "formulae": [
          {
            "name": "块流",
            "expr": "Q_block = n_emitter × q_emitter",
            "units": "LPH 或 L/min（根据需要转换）",
            "example": "1,200 个发射器 × 4 LPH = 4,800 LPH = 80 L/min"
          },
          {
            "name": "哈森-威廉姆斯水头损失 (SI)",
            "expr": "H_f = 10.67 × L × Q^1.852 / (C^1.852 × d^4.871)",
            "variables": "L: 长度 (m), Q: 流量 (L/s), C: HW 系数 (PVC ≈ 150), d: 内径 (m)",
            "note": "转换为 1 bar ≈ 10 m 水头的压力。"
          },
          {
            "name": "发射器压力要求",
            "expr": "P_发射器 ≥ P_min_额定（通常为 0.7–1.5 bar）"
          },
          {
            "name": "允许沿横向压力变化",
            "expr": "ΔP_横向 ≤ P_发射器的 20%",
            "note": "对于高价值作物或非常长的侧枝，使用≤10%。"
          }
        ],
        "workedExample": {
          "title": "快速横向检查",
          "given": [
            "发射器：4 LPH",
            "滴头间距：0.5m",
            "横向长度：60 m（Ø16 mm）",
            "目标 ΔP ≤ 0.2 bar"
          ],
          "calc": [
            "每侧发射器 = 60 / 0.5 = 120",
            "每支管流量 = 120 × 4 LPH = 480 LPH = 0.133 L/s",
            "使用 Hazen–Williams (C=150) 估算摩擦力并验证 ΔP < 0.2 bar",
            "如果 ΔP 高，则缩短横向或增加直径。"
          ],
          "result": "选择横向长度/直径以满足ΔP约束；然后调整子干管的尺寸以平衡块压力。"
        }
      },
      {
        "id": "布局",
        "title": "布局模式",
        "patterns": [
          {
            "name": "菜床（滴灌带）",
